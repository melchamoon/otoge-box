{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "apps/fetch": {
      "entry": ["src/**/*.ts", "scripts/**/*.ts", "db/*/migrations/*.js"],
      "ignoreBinaries": ["pg_restore"],
      "ignoreDependencies": ["pg", "pg-hstore"]
    }
  }
}
