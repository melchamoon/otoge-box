{
  "name": "otoge-box-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @otoge-box/web dev",
    "build": "pnpm --filter @otoge-box/web build",
    "start": "pnpm --filter @otoge-box/web start",
    "lint": "pnpm --recursive --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --filter @otoge-box/web test:coverage",
    "knip": "knip",
    "check:duplicates": "jscpd --min-lines 20 --min-tokens 60 --reporters console --exit-code 1 --no-colors --no-tips --format typescript --ignore '**/*.test.ts' --ignore 'apps/fetch/**' apps"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
