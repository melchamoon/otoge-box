{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["*"],
      "@config/*": ["config/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "config/**/*.ts",
    "db/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "data", "dist"]
}
